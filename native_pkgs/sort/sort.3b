(package sort)

(fn bubble-sort-i8 [v [i8]] void
  (let [count (cast i8 (len v))
        init-j 0i8
        last-j (cast i8 (- count 1i8))]
    (while true
      (let [init-swap -1i8
            prev-swap -1i8]
        (for [j init-j last-j]
          (when (> (nth v j) (nth v (+ j 1i8)))
            (swap (nth v j) (nth v (+ j 1i8)))
            (set prev-swap j)
            (when (= init-swap -1i8)
              (set init-swap j))))
        (when (= prev-swap -1i8) (return))
        (set init-j (max (- init-swap 1i8) 0i8))
        (set last-j prev-swap)))))

(fn bubble-sort-i16 [v [i16]] void
  (let [count (cast i16 (len v))
        init-j 0i16
        last-j (cast i16 (- count 1i16))]
    (while true
      (let [init-swap -1i16
            prev-swap -1i16]
        (for [j init-j last-j]
          (when (> (nth v j) (nth v (+ j 1i16)))
            (swap (nth v j) (nth v (+ j 1i16)))
            (set prev-swap j)
            (when (= init-swap -1i16)
              (set init-swap j))))
        (when (= prev-swap -1i16) (return))
        (set init-j (max (- init-swap 1i16) 0i16))
        (set last-j prev-swap)))))

(fn bubble-sort-i32 [v [i32]] void
  (let [count (cast i32 (len v))
        init-j 0
        last-j (- count 1)]
    (while true
      (let [init-swap -1
            prev-swap -1]
        (for [j init-j last-j]
          (when (> (nth v j) (nth v (+ j 1)))
            (swap (nth v j) (nth v (+ j 1)))
            (set prev-swap j)
            (when (= init-swap -1)
              (set init-swap j))))
        (when (= prev-swap -1) (return))
        (set init-j (max (- init-swap 1) 0))
        (set last-j prev-swap)))))

