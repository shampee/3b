        (return (+ mid 1u8)))
      (when (> key (nth v mid))
        (return (binary-search-u8 v key (+ mid 1u8) hi)))
      (when (= mid 0u8)
        (return 0u8))
      (binary-search-u8 v key lo (- mid 1u8))))
  
  (fn binary-search-u16 [v [u16] key u16 lo u16 hi u16] u16
    (when (<= hi lo)
      (return (if (> key (nth v lo)) (+ lo 1u16) lo)))
    (let [mid (/ (+ lo hi) 2u16)]
      (when (= key (nth v mid))
        (return (+ mid 1u16)))
      (when (> key (nth v mid))
        (return (binary-search-u16 v key (+ mid 1u16) hi)))
      (when (= mid 0u16)
