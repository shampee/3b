(fn insertion-sort-i8 [v [i8]] void
  (let [n (cast i8 (len v))]
    (for [i 1i8 n]
      (let [key (nth v i)
            j (- i 1i8)
            loc (binary-search-i8 v key 0i8 j)]
        (while (>= j loc)
          (set (nth v (+ j 1i8)) (nth v j))
          (-- j))
        (set (nth v (+ j 1i8)) key)))))

