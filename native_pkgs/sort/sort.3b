            (++ m)
            (++ s2))))))

  (fn internal-merge-sort-i8 [v [i8] l i8 r i8] void
    (when (< l r)
      (let [m (+ l (/ (- r l) 2i8))]
        (internal-merge-sort-i8 v l m)
        (internal-merge-sort-i8 v (+ m 1i8) r)
        (merge-i8 v l m r))))
  
  (fn internal-merge-sort-i16 [v [i16] l i16 r i16] void
    (when (< l r)
      (let [m (+ l (/ (- r l) 2i16))]
        (internal-merge-sort-i16 v l m)
        (internal-merge-sort-i16 v (+ m 1i16) r)
        (merge-i16 v l m r))))
  
  (fn internal-merge-sort-i32 [v [i32] l i32 r i32] void
    (when (< l r)
      (let [m (+ l (/ (- r l) 2))]
        (internal-merge-sort-i32 v l m)
        (internal-merge-sort-i32 v (+ m 1) r)
        (merge-i32 v l m r))))
  
  (fn internal-merge-sort-i64 [v [i64] l i64 r i64] void
    (when (< l r)
      (let [m (+ l (/ (- r l) 2i64))]
        (internal-merge-sort-i64 v l m)
        (internal-merge-sort-i64 v (+ m 1i64) r)
        (merge-i64 v l m r))))
  
  (fn internal-merge-sort-f32 [v [f32] l f32 r f32] void
    (when (< l r)
      (let [m (+ l (/ (- r l) 2.0f32))]
        (internal-merge-sort-f32 v l m)
        (internal-merge-sort-f32 v (+ m 1.0f32) r)
        (merge-f32 v l m r))))
  
  (fn internal-merge-sort-f64 [v [f64] l f64 r f64] void
    (when (< l r)
      (let [m (+ l (/ (- r l) 2.0f64))]
        (internal-merge-sort-f64 v l m)
        (internal-merge-sort-f64 v (+ m 1.0f64) r)
        (merge-f64 v l m r))))
  
