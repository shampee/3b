            (set prev-swap j)
            (when (= init-swap count)
              (set init-swap j))))
        (when (= prev-swap count) (return))
        (set init-j (if (> init-swap 0u8) (- init-swap 1u8) 0u8))
        (set last-j prev-swap)))))

