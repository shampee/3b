            (++ m)
            (++ s2))))))
  
  (fn merge-f32 [v [f32] start f32 mid f32 end f32] void
    (let [s start
          m mid
          s2 (+ m 1.0f32)]
      (when (<= (nth v m) (nth v s2)) (return))
