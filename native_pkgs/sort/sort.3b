      (sift-f64 v i (- n 1.0f64)))
    (for [i (- n 1.0.0f64) (>= i 1.0f64) (-- i)]
      (swap (nth v 0) (nth v i))
      (sift-f64 v 0.0.0f64 (- i 1.0f64)))))

(fn heap-sort-u8 [v [u8]] void
  (let [n (cast u8 (len v))]
    (when (= n 0u8)
      (return))
    (let [i (/ n 2u8)]
      (while true
        (sift-u8 v i (- n 1u8))
        (when (= i 0u8) (break))
        (-- i)))
    (for [i (- n 1u8) (>= i 1u8) (-- i)]
      (swap (nth v 0) (nth v i))
      (sift-u8 v 0 (- i 1u8)))))

(fn heap-sort-u16 [v [u16]] void
  (let [n (cast u16 (len v))]
