      (sift-u64 v 0 (- i 1u64)))))

(private
  (fn binary-search-i8 [v [i8] key i8 lo i8 hi i8] i8
    (when (<= hi lo)
      (return (if (> key (nth v lo)) (+ lo 1i8) lo)))
    (let [mid (/ (+ lo hi) 2i8)]
      (when (= key (nth v mid))
        (return (+ mid 1i8)))
      (when (> key (nth v mid))
        (return (binary-search-i8 v key (+ mid 1i8) hi)))
      (binary-search-i8 v key lo (- mid 1i8))))
  
  (fn binary-search-i16 [v [i16] key i16 lo i16 hi i16] i16
    (when (<= hi lo)
      (return (if (> key (nth v lo)) (+ lo 1i16) lo)))
    (let [mid (/ (+ lo hi) 2i16)]
      (when (= key (nth v mid))
        (return (+ mid 1i16)))
      (when (> key (nth v mid))
        (return (binary-search-i16 v key (+ mid 1i16) hi)))
      (binary-search-i16 v key lo (- mid 1i16))))
  
  (fn binary-search-i32 [v [i32] key i32 lo i32 hi i32] i32
    (when (<= hi lo)
      (return (if (> key (nth v lo)) (+ lo 1) lo)))
    (let [mid (/ (+ lo hi) 2)]
      (when (= key (nth v mid))
        (return (+ mid 1)))
      (when (> key (nth v mid))
        (return (binary-search-i32 v key (+ mid 1) hi)))
      (binary-search-i32 v key lo (- mid 1))))
  
  (fn binary-search-i64 [v [i64] key i64 lo i64 hi i64] i64
    (when (<= hi lo)
      (return (if (> key (nth v lo)) (+ lo 1i64) lo)))
    (let [mid (/ (+ lo hi) 2i64)]
      (when (= key (nth v mid))
        (return (+ mid 1i64)))
      (when (> key (nth v mid))
        (return (binary-search-i64 v key (+ mid 1i64) hi)))
      (binary-search-i64 v key lo (- mid 1i64))))
  
  (fn binary-search-f32 [v [f32] key f32 lo f32 hi f32] f32
    (when (<= hi lo)
      (return (if (> key (nth v lo)) (+ lo 1.0f32) lo)))
    (let [mid (/ (+ lo hi) 2.0f32)]
      (when (= key (nth v mid))
        (return (+ mid 1.0f32)))
      (when (> key (nth v mid))
        (return (binary-search-f32 v key (+ mid 1.0f32) hi)))
      (binary-search-f32 v key lo (- mid 1.0f32))))
  
  (fn binary-search-f64 [v [f64] key f64 lo f64 hi f64] f64
    (when (<= hi lo)
      (return (if (> key (nth v lo)) (+ lo 1.0f64) lo)))
    (let [mid (/ (+ lo hi) 2.0f64)]
