(private
  (fn sift-i8 [v [i8] pi i8 n i8] void
    (let [p pi
          u (nth v p)
          m (+ (* p 2i8) 1i8)]
      (while (<= m n)
        (when (and (< m n) (> (nth v (+ m 1i8)) (nth v m)))
          (++ m))
        (when (>= u (nth v m))
          (break))
        (set (nth v p) (nth v m))
        (set p m)
        (+= m (+ m 1i8))
        (set (nth v p) u))))
  
  (fn sift-i16 [v [i16] pi i16 n i16] void
    (let [p pi
          u (nth v p)
          m (+ (* p 2i16) 1i16)]
      (while (<= m n)
        (when (and (< m n) (> (nth v (+ m 1i16)) (nth v m)))
          (++ m))
        (when (>= u (nth v m))
          (break))
        (set (nth v p) (nth v m))
        (set p m)
        (+= m (+ m 1i16))
        (set (nth v p) u))))
  
  (fn sift-i32 [v [i32] pi i32 n i32] void
    (let [p pi
          u (nth v p)
          m (+ (* p 2) 1)]
      (while (<= m n)
        (when (and (< m n) (> (nth v (+ m 1)) (nth v m)))
          (++ m))
        (when (>= u (nth v m))
          (break))
        (set (nth v p) (nth v m))
        (set p m)
        (+= m (+ m 1))
        (set (nth v p) u))))
  
