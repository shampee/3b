(private
  (fn merge-i8 [v [i8] start i8 mid i8 end i8] void
    (let [s start
          m mid
          s2 (+ m 1i8)]
      (when (<= (nth v m) (nth v s2)) (return))
      (while (and (<= s m) (<= s2 end))
        (if (<= (nth v s) (nth v s2))
          (++ s)
          (let [v1 (nth v s2)
                i s2]
            (while (!= i s)
              (set (nth v i) (nth v (- i 1i8)))
              (-- i))
            (set (nth v s) v1)
            (++ s)
            (++ m)
            (++ s2))))))
  
  (fn merge-i16 [v [i16] start i16 mid i16 end i16] void
    (let [s start
          m mid
          s2 (+ m 1i16)]
      (when (<= (nth v m) (nth v s2)) (return))
      (while (and (<= s m) (<= s2 end))
        (if (<= (nth v s) (nth v s2))
          (++ s)
          (let [v1 (nth v s2)
                i s2]
            (while (!= i s)
              (set (nth v i) (nth v (- i 1i16)))
              (-- i))
            (set (nth v s) v1)
            (++ s)
            (++ m)
            (++ s2))))))
  
  (fn merge-i32 [v [i32] start i32 mid i32 end i32] void
    (let [s start
          m mid
          s2 (+ m 1)]
      (when (<= (nth v m) (nth v s2)) (return))
      (while (and (<= s m) (<= s2 end))
        (if (<= (nth v s) (nth v s2))
