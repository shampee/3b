(fn heap-sort-i8 [v [i8]] void
  (let [n (cast i8 (len v))]
    (when (= n 0i8)
      (return))
    (for [i (/ n 2i8) (>= i 0i8) (-- i)]
      (sift-i8 v i (- n 1i8)))
    (for [i (- n 1i8) (>= i 1i8) (-- i)]
      (swap (nth v 0) (nth v i))
      (sift-i8 v 0 (- i 1i8)))))

(fn heap-sort-i16 [v [i16]] void
  (let [n (cast i16 (len v))]
    (when (= n 0i16)
      (return))
    (for [i (/ n 2i16) (>= i 0i16) (-- i)]
      (sift-i16 v i (- n 1i16)))
    (for [i (- n 1i16) (>= i 1i16) (-- i)]
      (swap (nth v 0) (nth v i))
      (sift-i16 v 0 (- i 1i16)))))

(fn heap-sort-i32 [v [i32]] void
  (let [n (cast i32 (len v))]
    (when (= n 0)
      (return))
    (for [i (/ n 2) (>= i 0) (-- i)]
      (sift-i32 v i (- n 1)))
    (for [i (- n 1) (>= i 1) (-- i)]
      (swap (nth v 0) (nth v i))
      (sift-i32 v 0 (- i 1)))))

(fn heap-sort-i64 [v [i64]] void
  (let [n (cast i64 (len v))]
    (when (= n 0i64)
      (return))
    (for [i (/ n 2i64) (>= i 0i64) (-- i)]
      (sift-i64 v i (- n 1i64)))
    (for [i (- n 1i64) (>= i 1i64) (-- i)]
      (swap (nth v 0) (nth v i))
      (sift-i64 v 0 (- i 1i64)))))

(fn heap-sort-f32 [v [f32]] void
  (let [n (cast f32 (len v))]
    (when (= n 0.0.0f32)
      (return))
    (for [i (/ n 2.0.0f32) (>= i 0.0.0f32) (-- i)]
      (sift-f32 v i (- n 1.0.0f32)))
    (for [i (- n 1.0.0f32) (>= i 1.0.0f32) (-- i)]
      (swap (nth v 0) (nth v i))
      (sift-f32 v 0.0.0f32 (- i 1.0.0f32)))))

(fn heap-sort-f64 [v [f64]] void
  (let [n (cast f64 (len v))]
