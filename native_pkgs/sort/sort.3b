      (binary-search-u16 v key lo (- mid 1u16))))
  
  (fn binary-search-u32 [v [u32] key u32 lo u32 hi u32] u32
    (when (<= hi lo)
      (return (if (> key (nth v lo)) (+ lo 1u32) lo)))
    (let [mid (/ (+ lo hi) 2u32)]
      (when (= key (nth v mid))
        (return (+ mid 1u32)))
      (when (> key (nth v mid))
        (return (binary-search-u32 v key (+ mid 1u32) hi)))
      (when (= mid 0u32)
