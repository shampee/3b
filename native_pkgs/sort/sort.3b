(private
  (fn partition-i8 [v [i8] lo i8 hi i8] i8
    (let [pivot (nth v hi)
          i (- lo 1i8)]
      (for [j lo hi]
        (when (< (nth v j) pivot)
          (++ i)
          (swap (nth v i) (nth v j))))
      (swap (nth v (+ i 1i8)) (nth v hi))
      (+ i 1i8)))
  
  (fn partition-i16 [v [i16] lo i16 hi i16] i16
    (let [pivot (nth v hi)
          i (- lo 1i16)]
      (for [j lo hi]
        (when (< (nth v j) pivot)
          (++ i)
          (swap (nth v i) (nth v j))))
      (swap (nth v (+ i 1i16)) (nth v hi))
      (+ i 1i16)))
  
  (fn partition-i32 [v [i32] lo i32 hi i32] i32
    (let [pivot (nth v hi)
          i (- lo 1)]
      (for [j lo hi]
        (when (< (nth v j) pivot)
          (++ i)
          (swap (nth v i) (nth v j))))
      (swap (nth v (+ i 1)) (nth v hi))
      (+ i 1)))

  (fn partition-i64 [v [i64] lo i64 hi i64] i64
    (let [pivot (nth v hi)
          i (- lo 1i64)]
      (for [j lo hi]
        (when (< (nth v j) pivot)
          (++ i)
          (swap (nth v i) (nth v j))))
      (swap (nth v (+ i 1i64)) (nth v hi))
      (+ i 1i64)))
  
  (fn partition-f32 [v [f32] lo f32 hi f32] f32
    (let [pivot (nth v hi)
          i (- lo 1.0f32)]
      (for [j lo hi]
        (when (< (nth v j) pivot)
          (++ i)
          (swap (nth v i) (nth v j))))
      (swap (nth v (+ i 1.0f32)) (nth v hi))
      (+ i 1.0f32)))
  
  (fn partition-f64 [v [f64] lo f64 hi f64] f64
    (let [pivot (nth v hi)
          i (- lo 1.0f64)]
      (for [j lo hi]
        (when (< (nth v j) pivot)
          (++ i)
          (swap (nth v i) (nth v j))))
      (swap (nth v (+ i 1.0f64)) (nth v hi))
      (+ i 1.0f64)))
  
  (fn partition-u8 [v [u8] lo u8 hi u8] u8
    (let [pivot (nth v hi)
          i (- lo 1u8)]
      (for [j lo hi]
        (when (< (nth v j) pivot)
          (++ i)
          (swap (nth v i) (nth v j))))
      (swap (nth v (+ i 1u8)) (nth v hi))
      (+ i 1u8)))
  
  (fn partition-u16 [v [u16] lo u16 hi u16] u16
    (let [pivot (nth v hi)
          i (- lo 1u16)]
      (for [j lo hi]
        (when (< (nth v j) pivot)
          (++ i)
          (swap (nth v i) (nth v j))))
      (swap (nth v (+ i 1u16)) (nth v hi))
      (+ i 1u16)))
  
  (fn partition-u32 [v [u32] lo u32 hi u32] u32
    (let [pivot (nth v hi)
          i (- lo 1u32)]
      (for [j lo hi]
        (when (< (nth v j) pivot)
          (++ i)
          (swap (nth v i) (nth v j))))
      (swap (nth v (+ i 1u32)) (nth v hi))
      (+ i 1u32)))
  
  (fn partition-u64 [v [u64] lo u64 hi u64] u64
    (let [pivot (nth v hi)
          i (- lo 1u64)]
      (for [j lo hi]
        (when (< (nth v j) pivot)
          (++ i)
          (swap (nth v i) (nth v j))))
      (swap (nth v (+ i 1u64)) (nth v hi))
      (+ i 1u64)))

  (fn internal-quick-sort-i8 [v [i8] lo i8 hi i8] void
    (when (< lo hi)
      (let [pi (partition-i8 v lo hi)]
        (internal-quick-sort-i8 v lo (- pi 1i8))
        (internal-quick-sort-i8 v (+ pi 1i8) hi))))
  
  (fn internal-quick-sort-i16 [v [i16] lo i16 hi i16] void
    (when (< lo hi)
      (let [pi (partition-i16 v lo hi)]
        (internal-quick-sort-i16 v lo (- pi 1i16))
        (internal-quick-sort-i16 v (+ pi 1i16) hi))))
  
  (fn internal-quick-sort-i32 [v [i32] lo i32 hi i32] void
    (when (< lo hi)
      (let [pi (partition-i32 v lo hi)]
        (internal-quick-sort-i32 v lo (- pi 1))
        (internal-quick-sort-i32 v (+ pi 1) hi))))
  
  (fn internal-quick-sort-i64 [v [i64] lo i64 hi i64] void
    (when (< lo hi)
      (let [pi (partition-i64 v lo hi)]
        (internal-quick-sort-i64 v lo (- pi 1i64))
        (internal-quick-sort-i64 v (+ pi 1i64) hi))))
  
  (fn internal-quick-sort-f32 [v [f32] lo f32 hi f32] void
    (when (< lo hi)
      (let [pi (partition-f32 v lo hi)]
        (internal-quick-sort-f32 v lo (- pi 1.0f32))
        (internal-quick-sort-f32 v (+ pi 1.0f32) hi))))
  
  (fn internal-quick-sort-f64 [v [f64] lo f64 hi f64] void
    (when (< lo hi)
      (let [pi (partition-f64 v lo hi)]
        (internal-quick-sort-f64 v lo (- pi 1.0f64))
        (internal-quick-sort-f64 v (+ pi 1.0f64) hi))))
  
  (fn internal-quick-sort-u8 [v [u8] lo u8 hi u8] void
    (when (< lo hi)
      (let [pi (partition-u8 v lo hi)]
        (when (> pi 0u8)
          (internal-quick-sort-u8 v lo (- pi 1u8)))
        (internal-quick-sort-u8 v (+ pi 1u8) hi))))
  
  (fn internal-quick-sort-u16 [v [u16] lo u16 hi u16] void
    (when (< lo hi)
      (let [pi (partition-u16 v lo hi)]
        (when (> pi 0u16)
          (internal-quick-sort-u16 v lo (- pi 1u16)))
        (internal-quick-sort-u16 v (+ pi 1u16) hi))))
  
  (fn internal-quick-sort-u32 [v [u32] lo u32 hi u32] void
    (when (< lo hi)
      (let [pi (partition-u32 v lo hi)]
        (when (> pi 0u32)
          (internal-quick-sort-u32 v lo (- pi 1u32)))
        (internal-quick-sort-u32 v (+ pi 1u32) hi))))
  
  (fn internal-quick-sort-u64 [v [u64] lo u64 hi u64] void
    (when (< lo hi)
      (let [pi (partition-u64 v lo hi)]
        (when (> pi 0u64)
          (internal-quick-sort-u64 v lo (- pi 1u64)))
        (internal-quick-sort-u64 v (+ pi 1u64) hi)))))

(fn quick-sort-i8 [v [i8]] void
  (let [n (cast i8 (len v))
        i 0i8]
    (when (< n 2i8) (return))
    (internal-quick-sort-i8 v i (- n 1i8))))

(fn quick-sort-i16 [v [i16]] void
  (let [n (cast i16 (len v))
        i 0i16]
    (when (< n 2i16) (return))
    (internal-quick-sort-i16 v i (- n 1i16))))

(fn quick-sort-i32 [v [i32]] void
  (let [n (cast i32 (len v))
        i 0]
    (when (< n 2) (return))
    (internal-quick-sort-i32 v i (- n 1))))

(fn quick-sort-i64 [v [i64]] void
  (let [n (cast i64 (len v))
        i 0i64]
    (when (< n 2i64) (return))
    (internal-quick-sort-i64 v i (- n 1i64))))

(fn quick-sort-f32 [v [f32]] void
  (let [n (cast f32 (len v))
        i 0.0f32]
    (when (< n 2.0f32) (return))
    (internal-quick-sort-f32 v i (- n 1.0f32))))

(fn quick-sort-f64 [v [f64]] void
  (let [n (cast f64 (len v))
        i 0.0f64]
    (when (< n 2.0f64) (return))
    (internal-quick-sort-f64 v i (- n 1.0f64))))

(fn quick-sort-u8 [v [u8]] void
  (let [n (cast u8 (len v))
        i 0u8]
    (when (< n 2u8) (return))
    (internal-quick-sort-u8 v i (- n 1u8))))

