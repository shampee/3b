        (when (= i 0u32) (break))
        (-- i)))
    (for [i (- n 1u32) (>= i 1u32) (-- i)]
      (swap (nth v 0) (nth v i))
      (sift-u32 v 0 (- i 1u32)))))

(fn heap-sort-u64 [v [u64]] void
  (let [n (cast u64 (len v))]
    (when (= n 0u64)
      (return))
    (let [i (/ n 2u64)]
      (while true
