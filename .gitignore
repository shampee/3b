.gdb_history
*.o
*.d
base/*.o
base/*.d
3b
3b-sanitize
3b.exe
3b-lsp
3b-lsp-test
# Every test/*_test.c builds to an extensionless binary beside it (see the
# Makefile's `make check`). One glob rather than a line per suite: the
# hand-written lists this file and `clean` both used had to be extended for
# each new test, and `clean`'s had already fallen 20 binaries behind. The
# sources keep their .c extension, so they never match this.
test/*_test
*.a
a.out

# script.c's on-disk bytecode cache (load_or_compile_script) -- named
# `<source>.<content-hash>.3bc`, regenerated next to any `.3b`/`.3bs`
# script the first time it's vm/load'd (or `3b run`) after an edit.
*.3bc
generated_example
generated_example.c
3b_runtime.h
3b_runtime.c

# Build-time-only tool + its generated output (see tools/embed_runtime.c) --
# bakes runtime/bbb_*.{h,c} into the 3b binary itself; regenerated by `make`.
tools/embed_runtime
runtime_embed.h
script_embed.h
native_pkgs_embed.h

# `3b <package-dir>` compiles the target package AND every package it
# imports, writing every generated <name>.c/<name>.h pair (plus the
# self-contained 3b_runtime.h/.c runtime prelude) into that directory's
# own output/ folder -- never the source package's own directory. Never
# hand-write anything in there; it's always regenerated via `3b <dir>`
# (or `3b build <dir>` for any examples/ subdirectory).
output/

# Built example binaries -- one per examples/<name>/, always named after
# the package, which always matches its own directory name. Listed one by
# one rather than matched by a pattern: the only glob broad enough to
# catch an EXTENSION-LESS binary (`examples/*/*` plus a `!examples/*/*.*`
# re-include) would also swallow the extension-less binding SYMLINKS in
# examples/game3d/ (gl, glad, sdl, stbimg, stbtt), which are real tracked
# content, not artifacts. So: a new example needs its line added here.
examples/anon-struct-params/anon-struct-params
examples/arenas/arenas
examples/arrays/arrays
examples/checked-math/checked-math
examples/comparisons/comparisons
examples/control-flow/control-flow
examples/creatures/creatures
examples/dice/dice
examples/enums-and-flags/enums-and-flags
examples/game/game
examples/game3d/game3d
examples/hotreload-demo/hotreload-demo
examples/integers/integers
examples/lanes/lanes
examples/map/map
examples/multi-return/multi-return
examples/nested-scratch/nested-scratch
examples/os-portable/os-portable
examples/set/set
examples/streams/streams
examples/string-parsing/string-parsing
examples/structs/structs
examples/type-shorthand/type-shorthand
examples/vector/vector

# The same binaries under mingw, whose linker appends .exe regardless of
# the requested -o name (e.g. when testing `3b.exe run` under Wine). ONE
# glob suffices here, unlike the bare names above -- these always carry an
# extension, so nothing else in examples/ can match by accident.
examples/*/*.exe

# Files the examples themselves WRITE when run -- local session state, not
# example content. level.3b's save-level/load-level (game3d's F5/F9), the
# small file examples/streams/main.3b opens and reads back, and the three
# scratch files examples/os-portable/main.3b leaves behind (there is no
# remove-file verb on either backend).
examples/game3d/level.txt
examples/streams/streams-demo.txt
examples/os-portable/os-demo-*.txt

# The same two, landed in the REPO ROOT rather than beside their example.
# An example writes to its own working directory, and `3b run
# examples/streams/main.3b` from here -- the normal way to smoke-test one
# file on the VM -- makes that the root. Listed separately because a
# leading `/` is what confines the pattern to the root; without it these
# would also match a file of the same name anywhere in the tree.
/streams-demo.txt
/os-demo-*.txt

# `make os-parity`'s scratch directory -- it runs examples/os-portable
# through BOTH backends from in here (rather than from the repo root) so
# that example's own os-demo-*.txt scratch files land somewhere
# disposable, and diffs the two outputs.
.os-parity/
