(package stbtt)


(struct BakedChar "stbtt_bakedchar"
  [x0 u16
   y0 u16
   x1 u16
   y1 u16
   xoff f32
   yoff f32
   xadvance f32])

(struct AlignedQuad "stbtt_aligned_quad"
  [x0 f32
   y0 f32
   s0 f32
   t0 f32
   x1 f32
   y1 f32
   s1 f32
   t1 f32])

(private (extern (fn stbtt_BakeFontBitmap [data (const u8*) offset i32 pixel_height f32 pixels u8* pw i32 ph i32 first_char i32 num_chars i32 chardata BakedChar*] i32)))

(fn bake-font-bitmap
  [data (const u8*)
   offset i32
   pixel_height f32
   pixels u8*
   pw i32
   ph i32
   first_char i32
   num_chars i32
   chardata BakedChar*] i32
  (stbtt_BakeFontBitmap data offset pixel_height pixels pw ph first_char num_chars chardata))

(private (extern (fn stbtt_GetBakedQuad [chardata (const BakedChar*) pw i32 ph i32 char_index i32 xpos f32* ypos f32* q AlignedQuad* opengl_fillrule i32] void)))

(fn get-baked-quad
  [chardata (const BakedChar*)
   pw i32
   ph i32
   char_index i32
   xpos f32*
   ypos f32*
   q AlignedQuad*
   opengl_fillrule i32] void
  (stbtt_GetBakedQuad chardata pw ph char_index xpos ypos q opengl_fillrule))

(private (extern (fn stbtt_GetScaledFontVMetrics [fontdata (const u8*) index i32 size f32 ascent f32* descent f32* lineGap f32*] void)))

(fn get-scaled-font-v-metrics
  [fontdata (const u8*)
   index i32
   size f32
   ascent f32*
   descent f32*
   lineGap f32*] void
  (stbtt_GetScaledFontVMetrics fontdata index size ascent descent lineGap))

