(package gl)
;; `GL/gl.h` + `GL/glext.h` pull in EVERY GL function ever registered
;; (every vendor extension across 30 years, plus deprecated GL 1.x
;; fixed-function calls) -- gl.c unconditionally emits a wrapper for each
;; one, but GLAD (game/glad/gl.h) was deliberately generated for just
;; `core=4.3, extensions=''`, so most of those wrappers called a symbol
;; GLAD never declared/loaded, triggering an implicit-function-declaration
;; warning for each (and only "worked" at all because this system's
;; libGL.so happens to export many of them directly -- not something to
;; rely on). `GL/glcorearb.h` is the Khronos-maintained header scoped to
;; the modern core-profile GL ecosystem, which cuts the deprecated GL 1.x
;; fixed-function calls and most vendor-extension noise -- translating it
;; instead of gl.h/glext.h gets gl.3b's surface much closer to what GLAD
;; provides. It's not an exact match though: glcorearb.h still carries a
;; handful of ARB/EXT/vendor-suffixed functions, and (being continuously
;; updated upstream) core GL versions past 4.3 that GLAD's fixed
;; `core=4.3` generation doesn't have -- see the big `exclude-func` block
;; below for that remainder.
(headers ["KHR/khrplatform.h" "GL/glcorearb.h"])
(ifdef :common [GL_GLEXT_PROTOTYPES 1]) ; gates every GLAPI decl in glcorearb.h, same as gl.h/glext.h
(strip-const-prefix "GL_")
(strip-func-prefix "gl")
(type-map
  [GLenum     u32
   GLint      i32
   GLfloat    f32
   GLbitfield u32])
;; GLint64/GLuint64 are khronos_int64_t/khronos_uint64_t, which are glibc's
;; int64_t/uint64_t, which are `long`; 3b's i64/u64 are `long long`. Same width,
;; distinct C type, so every glGetInteger64v-style call passing one by address
;; warned. Pinning the two <stdint.h> leaves fixes the whole chain at once: each
;; alias above them is a transparent C typedef, so gl_GLint64 ends up being
;; int64_t itself. Pinning GLint64 directly would not work -- a pinned name has
;; to be visible in the generated *header*, which sees only 3b_runtime.h's
;; <stdint.h>/<stddef.h>, not glad/gl.h (`include-first` reaches just the .c).
;;
;; GLboolean is the same shape one level along: GL declares it `unsigned char`,
;; while 3b's `bool` is C's 1-byte `_Bool`. Same width and representation, but a
;; distinct C type, so `bool*` against glGetBooleanv's `GLboolean*` warned.
;; `type-map GLboolean bool` cannot fix that -- it substitutes `bool` at the use
;; site, losing the name -- and it has to come OUT of the map above for the pin
;; to reach GLboolean at all. Pinning names the leaf rather than `GLboolean`,
;; for the header-visibility reason just described. The 3b side stays `bool`, so
;; call sites still pass `true`/`false`.
(pin-type
  [int64_t   i64
   uint64_t  u64
   GLboolean bool "unsigned char"])
(arena-outparam gen-textures [count-param 1 out-param 2])
;; Not covered by GLAD's macro redirection (game/glad/gl.h) and not real
;; exported symbols in this system's libGL.so either -- would be link
;; errors (`undefined reference`) if left in, since gl.c unconditionally
;; emits a wrapper for every translated function whether the game calls it
;; or not. None of these are used by the game.
(exclude-func [glBlendEquationSeparateATI
               glBufferPageCommitmentMemNV
               glCreateSemaphoresNV
               glGetSemaphoreParameterivNV
               glNamedBufferPageCommitmentMemNV
               glSemaphoreParameterivNV
               glTexPageCommitmentMemNV
               glTexturePageCommitmentMemNV])
;; Real functions (glcorearb.h does declare them), but NOT covered by
;; GLAD's macro redirection (game/glad/gl.h, generated for `core=4.3,
;; extensions=''`) -- either an ARB/EXT/vendor-suffixed extension
;; glcorearb.h still carries, or a core function added after GL 4.3.
;; Left in, gl.c's unconditional per-function wrapper would call a symbol
;; with no declaration in scope: an implicit-function-declaration warning
;; at best, and on any driver that doesn't happen to export the symbol
;; directly from libGL.so, an undefined-reference link error. None of
;; these are used by the game; regenerate this list (see cstring_char_type
;; memory / this file's translate invocation) if GLAD is ever regenerated
;; for a newer core version or with extensions enabled.
(exclude-func [
               glActiveProgramEXT glApplyFramebufferAttachmentCMAAINTEL glBeginConditionalRenderNV
               glBeginPerfMonitorAMD glBeginPerfQueryINTEL glBindBuffersBase glBindBuffersRange
               glBindImageTextures glBindMultiTextureEXT glBindSamplers glBindShadingRateImageNV glBindTextureUnit
               glBindTextures glBindVertexBuffers glBlendBarrierKHR glBlendBarrierNV glBlendEquationSeparateiARB
