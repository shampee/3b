(alias size size_t)

(private (extern (fn cgltf_parse [options (const options*) data (const any) size size out_data data**] result)))

(fn parse
  [options (const options*)
   data (const any)
   size size
   out_data data**] result
  (cgltf_parse options data size out_data))

(private (extern (fn cgltf_parse_file [options (const options*) path (const char*) out_data data**] result)))

(fn parse-file
  [options (const options*)
   path (const char*)
   out_data data**] result
