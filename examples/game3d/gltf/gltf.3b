(private (extern (fn cgltf_load_buffer_base64 [options (const options*) size size base64 (const char*) out_data any*] result)))

(fn load-buffer-base64
  [options (const options*)
   size size
   base64 (const char*)
   out_data any*] result
  (cgltf_load_buffer_base64 options size base64 out_data))

